    "usageGuidance": {
      "do": [
        "建议：Use pure white ({#FFFFFF}) as canvas light / charcoal-black ({#212121}) dark — NOT true black。",
        "建议：Make the send button a circle — black-on-white light, white-on-black dark, 32pt with up-arrow。",
        "建议：Keep the UI monochromatic — no brand accent beyond subtle blue ({#2A7FFF}) on links。",
        "建议：Give user messages a soft-gray bubble ({#F7F7F8}) — assistant messages get NO bubble。",
        "建议：Render markdown in assistant responses — code blocks, tables, LaTeX, headings all rendered cleanly。"
      ],
      "dont": [
        "避免：use bubbles around assistant responses — plain inline text flow is the rule。",
        "避免：use ChatGPT Green ({#10A37F}) — it's been mostly retired; keep the UI monochromatic。",
        "避免：make the send button square or rectangular — it's a circle。",
        "避免：use heavy shadows on content — ChatGPT is flat; shadows only on floating ephemeral UI。",
        "避免：render markdown naively — code blocks need syntax highlighting + copy button。"
      ]
    },
