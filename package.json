{
  "name": "@axhub/make",
  "version": "0.6.20-beta.1",
  "description": "Axhub Make management server and admin UI",
  "private": true,
  "type": "module",
  "bin": {
    "make": "./bin/cli.mjs",
    "axhub-make": "./bin/cli.mjs",
    "make-server": "./bin/cli.mjs"
  },
  "files": [
    "bin",
    "src/server/**/*.ts",
    "src/server/converters/*-converter.mjs",
    "!src/server/**/*.test.ts",
    "!src/server/**/*.test.tsx",
    "!src/server/**/__tests__",
    "!src/server/**/__tests__/**",
    "src/common/makeClientTemplate.ts",
    "src/common/documentTemplates.ts",
    "client/vite-plugins/annotationSourceMarkdown.ts",
    "client/vite-plugins/canvasHotUpdateFilter.ts",
    "client/vite-plugins/clientPreviewPlugin.ts",
    "client/vite-plugins/localEditingApi.ts",
    "client/vite-plugins/utils/moduleSpecifierQuery.ts",
    "client/vite-plugins/utils/previewTitle.ts",
    "dist/admin",
    "vendor/axhub-export-core/dist/**",
    "vendor/axhub-commentary/dist/**",
    "vendor/agent-surface/dist/**",
    "vendor/tiptap-editor/dist/**",
    "vendor/**/package.json",
    "vendor/vendor-*.generated.json",
    "package.json"
  ],
  "scripts": {
    "vendor:sync": "node scripts/sync-vendor-package.mjs",
    "dev": "pnpm --filter @axhub/make-client dev",
    "server:dev": "pnpm vendor:sync && tsx watch --ignore './src/index/**' --ignore './dist/**' --ignore './vendor/**' --ignore './src/dev-template/**' --ignore './src/spec-template/**' --ignore './src/canvas-template/**' --ignore './src/html-template/**' --ignore './*.timestamp-*' src/server/cli.ts -- --dev",
    "make-server:dev": "pnpm server:dev",
    "server:dev:local-axhub": "pnpm server:dev -- --axhub-online-base-url http://127.0.0.1:3001",
    "server:dev:online-axhub": "pnpm server:dev -- --axhub-online-base-url https://axhub.im",
    "make-server:dev:local-axhub": "pnpm server:dev:local-axhub",
    "make-server:dev:online-axhub": "pnpm server:dev:online-axhub",
    "build": "pnpm vendor:sync && vite build && vite build --config vite.axure-export.config.ts && pnpm --filter @axhub/make-client build",
    "admin:build": "pnpm vendor:sync && vite build && vite build --config vite.axure-export.config.ts",
    "test:production:html-bootstrap": "pnpm admin:build && node scripts/regression/html-template-production-import.mjs --admin-root dist/admin",
    "test:production:html-spec": "pnpm admin:build && pnpm exec tsx scripts/regression/html-spec-dynamic-origin.mjs --admin-root dist/admin",
    "server:build": "pnpm vendor:sync && tsc --noEmit -p tsconfig.node.json",
    "client:typecheck": "pnpm --filter @axhub/make-client typecheck",
    "client:build": "pnpm --filter @axhub/make-client build",
    "client-template:font:subset:beginner-guide": "node scripts/client-template-production/subset-beginner-guide-fonts.mjs",
    "client-template:screenshots:collect": "node scripts/client-template-production/collect-mobile-theme-screenshots.mjs",
    "client-template:screenshots:status": "node scripts/client-template-production/report-mobile-theme-screenshot-status.mjs",
    "client-template:screenshots:wire": "node scripts/client-template-production/sync-mobile-theme-screenshot-wiring.mjs",
    "preview": "vite preview",
    "test": "pnpm vendor:sync && AXHUB_MAKE_COVERAGE_SCOPE=all vitest run --coverage",
    "test:watch": "pnpm vendor:sync && vitest",
    "test:coverage": "pnpm vendor:sync && AXHUB_MAKE_COVERAGE_SCOPE=all vitest run --coverage",
    "server:test": "pnpm vendor:sync && AXHUB_MAKE_COVERAGE_SCOPE=server vitest run --coverage src/server/__tests__",
    "server:test:watch": "pnpm vendor:sync && vitest src/server/__tests__",
    "server:test:coverage": "pnpm vendor:sync && AXHUB_MAKE_COVERAGE_SCOPE=server vitest run --coverage src/server/__tests__",
    "server:test:api": "pnpm vendor:sync && AXHUB_MAKE_COVERAGE_SCOPE=server vitest run --coverage src/server/__tests__/projects-*-api.test.ts src/server/__tests__/http.test.ts",
    "server:test:runtime": "pnpm vendor:sync && AXHUB_MAKE_COVERAGE_SCOPE=server vitest run --coverage src/server/__tests__/runtimeProxy.test.ts src/server/__tests__/quickEditRuntimeApi.test.ts src/server/__tests__/assistant-runtime-api.test.ts src/server/__tests__/ide-open-api.test.ts",
    "server:test:exports": "pnpm vendor:sync && AXHUB_MAKE_COVERAGE_SCOPE=server vitest run --coverage src/server/__tests__/export-make-api.test.ts src/server/__tests__/projects-export-bridge-api.test.ts",
    "test:frontend:acp-host": "node scripts/regression/run-acp-host-regression.mjs",
    "test:frontend:real-acp-canvas-artifact": "node scripts/regression/run-real-acp-canvas-artifact-regression.mjs",
    "test:frontend:real-acp-canvas-artifact:placeholder": "node scripts/regression/run-real-acp-canvas-artifact-regression.mjs --entry=placeholder-start",
    "test:frontend:real-acp-canvas-artifact:refresh-running": "node scripts/regression/run-real-acp-canvas-artifact-regression.mjs --recovery=refresh-during-generation",
    "test:frontend:real-acp-canvas-artifact:refresh-after-canvas-write": "node scripts/regression/run-real-acp-canvas-artifact-regression.mjs --recovery=refresh-after-canvas-write",
    "test:frontend:real-acp-canvas-artifact:placeholder-refresh-running": "node scripts/regression/run-real-acp-canvas-artifact-regression.mjs --entry=placeholder-start --recovery=refresh-during-generation",
    "test:frontend:real-acp-canvas-artifact:placeholder-refresh-after-canvas-write": "node scripts/regression/run-real-acp-canvas-artifact-regression.mjs --entry=placeholder-start --recovery=refresh-after-canvas-write",
    "smoke:test": "tsx scripts/smoke/run-smoke.mjs",
    "smoke:test:unit": "node --test scripts/smoke/smoke-core.test.mjs",
    "opencode-bridge:test": "pnpm vendor:sync && vitest run src/index/hooks/openCodeBridgeContext.test.ts src/index/hooks/useAxhubBridge.test.ts src/index/components/sidebar/OpenInDropdown.test.ts src/index/components/sidebar/ContentPanel.test.ts src/index/components/sidebar/IconNavigation.test.ts src/index/app/IndexPage.test.ts src/server/__tests__/opencode-bridge-regression.test.ts src/server/__tests__/adminStatic.test.ts",
    "release:make:prepare": "node scripts/release-make.mjs --prepare-only",
    "release:make:test-local": "node scripts/release-make.mjs --test-local",
    "release:make:dry-run": "node scripts/release-make.mjs --dry-run",
    "release:make:npm:beta": "node scripts/release-make.mjs --skip-github --npm-tag beta",
    "release:make-client-template:prepare": "node scripts/release-make.mjs --template-only --prepare-only",
    "release:make-client-template": "node scripts/release-make.mjs --template-only",
    "release:make:mirror:gitee": "node scripts/release-make-mirror-gitee.mjs",
    "release:make": "node scripts/release-make.mjs"
  },
  "dependencies": {
    "@ant-design/cssinjs": "^2.1.0",
    "@ant-design/icons": "^6.1.0",
    "@ant-design/x": "^2.1.1",
    "@ant-design/x-markdown": "^2.1.1",
    "@assistant-ui/react": "0.15.5",
    "@assistant-ui/react-ai-sdk": "1.4.4",
    "@axhub/acp": "0.1.13",
    "@axhub/agent-surface": "file:vendor/agent-surface",
    "@axhub/commentary": "file:vendor/axhub-commentary",
    "@axhub/excalidraw": "file:vendor/axhub-excalidraw",
    "@braintree/sanitize-url": "7.1.1",
    "@excalidraw/mermaid-to-excalidraw": "2.2.2",
    "@lobehub/icons": "^4.12.0",
    "@noble/hashes": "^1.8.0",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toggle-group": "^1.1.11",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@zumer/snapdom": "^2.12.9",
    "ai": "^6.0.188",
    "antd": "^6.3.0",
    "archiver": "^7.0.1",
    "assistant-stream": "0.3.16",
    "axhub-export-core": "file:vendor/axhub-export-core",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "dayjs": "1.11.19",
    "execa": "^9.6.1",
    "fflate": "^0.8.2",
    "html-to-image": "^1.11.13",
    "lodash.throttle": "^4.1.1",
    "lucide-react": "^0.475.0",
    "motion": "^12.38.0",
    "overlayscrollbars": "^2.15.1",
    "overlayscrollbars-react": "^0.5.6",
    "papaparse": "^5.5.3",
    "parse5": "7.3.0",
    "radix-ui": "^1.4.3",
    "re-resizable": "^6.11.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.0",
    "tailwindcss-animate": "^1.0.7",
    "tiptap-editor": "file:vendor/tiptap-editor",
    "tsx": "^4.21.0",
    "typescript": "^5.0.0",
    "use-sync-external-store": "1.6.0",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.18",
    "@types/archiver": "^7.0.0",
    "@types/node": "^20.0.0",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@types/react-test-renderer": "^18.0.7",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.0.0",
    "@vitest/coverage-v8": "4.0.16",
    "react-test-renderer": "18.2.0",
    "sass-embedded": "^1.97.3",
    "sharp": "^0.34.5",
    "subset-font": "^2.5.0",
    "tailwindcss": "^4.1.18",
    "vite": "5.4.21",
    "vitest": "4.0.16"
  },
  "pnpm": {
    "overrides": {
      "react": "18.2.0",
      "react-dom": "18.2.0",
      "@types/react": "^18.2.0",
      "@types/react-dom": "^18.2.0",
      "@assistant-ui/core": "0.3.7",
      "@assistant-ui/store": "0.3.6",
      "assistant-cloud": "0.1.35"
    }
  }
}
